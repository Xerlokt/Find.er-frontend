{
  "expo": {
    "name": "Find.er",
    "slug": "finder-candidato",
    "scheme": "finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.finder.candidato"
    },
    "android": {
      "package": "app.finder.candidato",
      "adaptiveIcon": {
        "backgroundColor": "#6C4DF6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "o Find.er usa sua localização para achar vagas perto de você."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F4EFE6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#6C4DF6",
          "imageWidth": 220
        }
      ]
    ]
  }
}